# MatchLayer — example environment file
#
# Copy this file to `.env` at the repo root:
#   cp .env.example .env
#
# The defaults below are wired to the local docker-compose stack
# (Postgres, Redis, MinIO) so a fresh checkout can run both apps with
# no further edits. Real secrets must NEVER be committed here — `.env`
# is gitignored, this file is the committed sample.
#
# Variable contract is defined in
# `.kiro/specs/phase-1-foundation/design.md` §12.

# ---------------------------------------------------------------------------
# Backend (apps/api) — read by `matchlayer_api.config.Settings`
# ---------------------------------------------------------------------------

# Runtime environment. Drives logging format (console in development,
# JSON otherwise) and other env-conditional behavior.
# One of: development | staging | production
MATCHLAYER_ENVIRONMENT=development

# Log level for structlog. One of: debug | info | warning | error
MATCHLAYER_LOG_LEVEL=info

# Postgres async DSN. Must use the `postgresql+asyncpg://` driver form —
# Alembic swaps it to `+psycopg` internally for sync migrations.
# Matches the docker-compose `postgres` service defaults.
MATCHLAYER_DATABASE_URL=postgresql+asyncpg://matchlayer:dev_only_password@localhost:5432/matchlayer

# Redis DSN, including database index. Matches the docker-compose `redis` service.
MATCHLAYER_REDIS_URL=redis://localhost:6379/0

# S3 / MinIO configuration.
# In local dev this points at the MinIO container; in production this is left
# empty / unset so boto3 talks to real AWS S3 directly.
MATCHLAYER_S3_ENDPOINT_URL=http://localhost:9000
MATCHLAYER_S3_REGION=us-east-1
MATCHLAYER_S3_ACCESS_KEY_ID=matchlayer
MATCHLAYER_S3_SECRET_ACCESS_KEY=dev_only_password

# S3 bucket name. Created manually in MinIO via `mc mb` for local dev
# (auto-bootstrap arrives in `phase-1-matching`).
MATCHLAYER_S3_BUCKET=matchlayer-dev

# Comma-separated list of allowed CORS origins for the API.
# Local dev only needs the Next.js dev server.
MATCHLAYER_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication (apps/api) — JWT, rate limiting, lockout.
# Defined by the phase-1-auth design §17.1.
# ---------------------------------------------------------------------------

# JWT signing secret. MUST be >= 32 bytes UTF-8.
# The API refuses to start if this constraint is violated (config.py
# Settings._jwt_secret_min_length validator). Generate a real one for
# staging/prod with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATCHLAYER_JWT_SECRET=change-me-development-only-32+chars

# Token TTLs (seconds). Access = 15 min, Refresh = 7 days.
MATCHLAYER_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
MATCHLAYER_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Account lockout: lock after N failed logins inside WINDOW seconds,
# stay locked for DURATION seconds.
MATCHLAYER_AUTH_LOCKOUT_THRESHOLD=10
MATCHLAYER_AUTH_LOCKOUT_WINDOW_SECONDS=900
MATCHLAYER_AUTH_LOCKOUT_DURATION_SECONDS=900

# Base URL of the web app. Used to build dev-mode reset links.
MATCHLAYER_WEB_BASE_URL=http://localhost:3000

# Postgres role that the auth migration grants INSERT/SELECT on
# audit_events to. This is intentionally a least-privilege role
# distinct from the docker-compose ``POSTGRES_USER`` (which is the
# table owner and bypasses GRANT/REVOKE). The role is provisioned
# by ``infra/docker/postgres-init/01-create-app-role.sql`` on first
# boot of the data volume and re-asserted by the migration on every
# upgrade.
MATCHLAYER_DATABASE_APP_ROLE=matchlayer_app
# Password for ``MATCHLAYER_DATABASE_APP_ROLE``. Used by the
# integration test suite (audit_role_engine fixture, INV-1) and by
# any local tooling that connects as the app role. Dev-only; in
# production the role is provisioned by AWS Secrets Manager-backed
# bootstrap.
MATCHLAYER_DATABASE_APP_ROLE_PASSWORD=dev_only_app_role_password

# Rate-limit defaults per endpoint. Sliding-window via Redis SORTED SET.
MATCHLAYER_AUTH_RATE_LIMIT_REGISTER_IP_LIMIT=10
MATCHLAYER_AUTH_RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=900
MATCHLAYER_AUTH_RATE_LIMIT_LOGIN_EMAIL_LIMIT=10
MATCHLAYER_AUTH_RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
MATCHLAYER_AUTH_RATE_LIMIT_LOGIN_IP_LIMIT=50
MATCHLAYER_AUTH_RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
MATCHLAYER_AUTH_RATE_LIMIT_REFRESH_IP_LIMIT=60
MATCHLAYER_AUTH_RATE_LIMIT_REFRESH_IP_WINDOW_SECONDS=60
MATCHLAYER_AUTH_RATE_LIMIT_RESET_REQUEST_EMAIL_LIMIT=5
MATCHLAYER_AUTH_RATE_LIMIT_RESET_REQUEST_EMAIL_WINDOW_SECONDS=3600
MATCHLAYER_AUTH_RATE_LIMIT_RESET_REQUEST_IP_LIMIT=20
MATCHLAYER_AUTH_RATE_LIMIT_RESET_REQUEST_IP_WINDOW_SECONDS=3600
MATCHLAYER_AUTH_RATE_LIMIT_RESET_CONFIRM_IP_LIMIT=20
MATCHLAYER_AUTH_RATE_LIMIT_RESET_CONFIRM_IP_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Matching (apps/api) — resume upload, extraction, scoring, rate limits,
# and daily quotas. Defined by the phase-1-matching design §12 and read by
# `matchlayer_api.config.Settings`. Object storage reuses the S3 settings
# above — there is no separate resume-storage credential set.
# ---------------------------------------------------------------------------

# Hard upload size limit for `POST /api/v1/resumes`, in bytes. Requests whose
# declared length exceeds this are rejected with 413 before any object write.
# Default 5 MiB.
MATCHLAYER_RESUME_MAX_BYTES=5242880

# DOCX zip-bomb guard: maximum total uncompressed size across all archive
# entries, in bytes. Exceeding this rejects the upload with 422. Default 50 MiB.
MATCHLAYER_RESUME_MAX_DECOMPRESSED_BYTES=52428800

# DOCX zip-bomb guard: maximum number of entries in the archive. Exceeding
# this rejects the upload with 422.
MATCHLAYER_RESUME_MAX_ARCHIVE_ENTRIES=256

# Wall-clock timeout for synchronous text extraction, in seconds. Extraction
# that exceeds this is aborted and the resume is marked extraction failed.
MATCHLAYER_RESUME_EXTRACTION_TIMEOUT_SECONDS=15

# Upper bound on retained extracted characters. Extracted text is truncated to
# this length and the retained count stored in `resumes.extraction_char_count`.
MATCHLAYER_RESUME_MAX_EXTRACTED_CHARS=200000

# Trimmed-length bounds for the pasted `job_description` on `POST /api/v1/matches`.
# A job description outside this inclusive range is rejected with 422.
MATCHLAYER_JD_MIN_CHARS=30
MATCHLAYER_JD_MAX_CHARS=50000

# Cap on the analyzed keyword set derived from a job description.
MATCHLAYER_MATCH_MAX_KEYWORDS=50

# Cap on the number of improvement suggestions returned per match.
MATCHLAYER_MATCH_MAX_SUGGESTIONS=10

# Match score component weights. These MUST sum to exactly 1.0 — the API
# refuses to start otherwise (config.py weight-sum validator).
MATCHLAYER_SCORE_WEIGHT_SIMILARITY=0.6
MATCHLAYER_SCORE_WEIGHT_KEYWORD=0.4

# Per-user sliding-window rate limits (60s window) for the resume-upload and
# match-creation endpoints. Reuses the phase-1-auth Redis Rate_Limiter.
MATCHLAYER_RESUME_RATE_LIMIT_PER_MIN=10
MATCHLAYER_MATCH_RATE_LIMIT_PER_MIN=20

# Per-user daily quotas (UTC calendar day) enforced as a cost-as-DoS control.
# Counted in Postgres so they survive a Redis outage. Adjust these to loosen
# or tighten the per-day upload/scoring caps for local development.
MATCHLAYER_RESUME_DAILY_QUOTA=20
MATCHLAYER_MATCH_DAILY_QUOTA=50

# ---------------------------------------------------------------------------
# Semantic pipeline (apps/api) — embeddings and skill extraction. Defined by
# the phase-2-nlp-embeddings design §10 and read by
# `matchlayer_api.config.Settings`. These values are consumed only by the
# ML adapter layer and injected into the scoring core.
# ---------------------------------------------------------------------------

# Pinned Sentence Transformers model name. Together with the revision below
# this makes every stored embedding reproducible and drives the
# reuse-versus-regenerate decision at match time.
MATCHLAYER_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Pinned Hugging Face commit SHA for the model above. The container build
# snapshots exactly this revision; runtime never contacts the hub.
MATCHLAYER_EMBEDDING_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf

# Local directory holding the model artifact. Inside the API image this is
# the baked path; for local dev point it at wherever you downloaded the
# snapshot (e.g. via `huggingface_hub.snapshot_download`).
MATCHLAYER_EMBEDDING_MODEL_PATH=/app/models/all-MiniLM-L6-v2

# Expected encoder output dimension. Must equal the `vector(384)` DDL literal
# declared by the pgvector migration — the API fails startup on any mismatch
# rather than letting writes fail later.
MATCHLAYER_EMBEDDING_DIMENSION=384

# Per-input wall-clock bound (seconds) for embedding generation end-to-end,
# including chunking and aggregation. Exceeding it triggers the per-request
# Phase 1 deterministic fallback, never a 5xx.
MATCHLAYER_EMBEDDING_TIMEOUT_SECONDS=20

# Pinned spaCy pipeline name used by the skill extractor. The installed
# package version is read from package metadata and stamped into the
# scorer version.
MATCHLAYER_SPACY_PIPELINE=en_core_web_sm

# ---------------------------------------------------------------------------
# LLM layer (apps/api) — provider client, cost controls, and feature bounds.
# Defined by the phase-3-llm-layer design §"Configuration" and read by
# `matchlayer_api.config.Settings`. All numeric values below MUST be
# positive (and MAX_QUESTIONS >= 5) — the API refuses to start otherwise.
# ---------------------------------------------------------------------------

# Base URL of the LLM provider's OpenAI-compatible API. Only the single
# provider adapter module talks to this endpoint.
MATCHLAYER_LLM_BASE_URL=https://openrouter.ai/api/v1

# App-owned OpenRouter API key. Leave BLANK to run without LLM features —
# the API starts normally and serves deterministic fallbacks instead.
# Set a real key (https://openrouter.ai/keys) to enable them; the key is
# validated against the provider at startup. NEVER commit a real key —
# `.env` is gitignored, this placeholder is non-functional.
MATCHLAYER_LLM_API_KEY=

# Model identifier sent to the provider. Changing this swaps the model
# for all subsequent LLM calls without a code change.
MATCHLAYER_LLM_MODEL=anthropic/claude-haiku-4.5

# Per-request wall-clock timeout (seconds) covering the full provider
# call including streaming. Expiry aborts the call and serves a fallback.
MATCHLAYER_LLM_TIMEOUT_SECONDS=60

# Per-request maximum output tokens, always set on every provider call.
MATCHLAYER_LLM_MAX_OUTPUT_TOKENS=4096

# Per-user daily LLM-call quota (UTC calendar day). Exceeding it returns
# 429 before any provider call. Cost-as-DoS control.
MATCHLAYER_LLM_DAILY_QUOTA=25

# Global monthly spend ceiling (USD) for the spend circuit breaker.
# Tracked spend at or above this opens the breaker (503 for LLM features)
# until the UTC month rolls over or the limit is raised.
MATCHLAYER_LLM_MONTHLY_SPEND_LIMIT_USD=10

# Bullet rewriter request bounds: max bullets per request and max
# characters per bullet. Requests outside these bounds get 422 pre-LLM.
MATCHLAYER_LLM_MAX_BULLETS=5
MATCHLAYER_LLM_MAX_BULLET_CHARS=500

# Upper bound on questions per interview question set. The schema floor
# is 5, so this MUST be >= 5 — the API refuses to start otherwise.
MATCHLAYER_LLM_MAX_QUESTIONS=15

# TTL (seconds) for cached LLM results on Redis. Default 24 hours.
MATCHLAYER_LLM_CACHE_TTL_SECONDS=86400

# Computed-cost fallback pricing (USD per million tokens), used only when
# the provider's usage payload carries no reported cost.
MATCHLAYER_LLM_PRICE_INPUT_USD_PER_MTOK=1.00
MATCHLAYER_LLM_PRICE_OUTPUT_USD_PER_MTOK=5.00

# ---------------------------------------------------------------------------
# Agentic workflows (apps/api) — SQS Job_Queue, agent execution bounds, and
# OpenTelemetry tracing. Defined by the phase-4-agentic design §11 and read
# by `matchlayer_api.config.Settings`. The placeholders below are wired to
# the docker-compose `localstack` service (SQS emulation), so the full
# async path (enqueue → consume → execute) runs locally without AWS
# credentials. In production these point at real AWS SQS instead — the two
# environments differ only in these configuration values.
# ---------------------------------------------------------------------------

# Full URL of the SQS Job_Queue the API enqueues analyze jobs on and the
# Agent_Worker consumes from. The queue is created on stack start by
# `infra/docker/localstack-init/01-create-queues.sh` (LocalStack uses the
# dummy account id 000000000000). In production this is the real AWS SQS
# queue URL.
MATCHLAYER_SQS_QUEUE_URL=http://localhost:4566/000000000000/matchlayer-agent-jobs

# AWS region for SQS API calls. LocalStack accepts any region; must match
# the queue's region in production.
MATCHLAYER_SQS_REGION=us-east-1

# SQS endpoint override. Points boto3/aioboto3 at the LocalStack container
# for local dev. Leave EMPTY / unset in production so the client talks to
# real AWS SQS directly. (Inside docker-compose containers use
# http://localstack:4566 instead of localhost.)
MATCHLAYER_SQS_ENDPOINT_URL=http://localhost:4566

# Per-node wall-clock timeout, in seconds. An agent node exceeding this is
# abandoned and routed to its Degraded_Output path; the run continues.
MATCHLAYER_AGENT_NODE_TIMEOUT_SECONDS=20

# Maximum SQS delivery attempts per Agent_Job (a count, not seconds). A
# redelivered message for a job that has already recorded this many
# attempts transitions the job to `failed` and is acknowledged.
MATCHLAYER_AGENT_MAX_ATTEMPTS=2

# Per-user sliding-window rate limit (requests per 60s window) for
# `POST /api/v1/matches/{id}/analyze`. Exceeding it returns 429.
MATCHLAYER_AGENT_ANALYZE_RATE_LIMIT_PER_MINUTE=10

# Per-user sliding-window rate limit (requests per 60s window) for
# `GET /api/v1/jobs/{id}` polling. Sized for a 2s poll interval with room.
MATCHLAYER_AGENT_JOB_POLL_RATE_LIMIT_PER_MINUTE=120

# TTL (seconds) for Agent_Cache entries on Redis — completed agent outputs
# keyed by (agent, prompt_version, input_hash), scoped per user. Default
# 24 hours. Reduces repeat LLM spend for identical inputs.
MATCHLAYER_AGENT_CACHE_TTL_SECONDS=86400

# OTLP exporter endpoint for OpenTelemetry traces. Leave EMPTY to disable
# export entirely — tracing then operates as a no-op with zero behavioral
# impact (no collector runs in the local stack by default). Set to an OTLP
# collector URL (e.g. http://localhost:4318) to export spans.
MATCHLAYER_OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name stamped on emitted spans (OTel `service.name` resource
# attribute). The API uses `matchlayer-api`; the Agent_Worker overrides
# this to `matchlayer-worker` so the two processes are distinguishable
# in trace backends.
MATCHLAYER_OTEL_SERVICE_NAME=matchlayer-api

# ---------------------------------------------------------------------------
# Frontend (apps/web) — only `NEXT_PUBLIC_*` values are exposed to the browser
# ---------------------------------------------------------------------------

# Base URL the web app uses to reach the FastAPI backend.

# Server-side (Next.js) target for the dev API proxy. The browser talks to
# the API through same-origin relative /api/* URLs (next.config.mjs rewrites);
# the Next server itself needs an absolute API origin to forward to and for the
# Authenticated_Shell session check. Defaults to the local API.
MATCHLAYER_API_PROXY_TARGET=http://localhost:8000

# Leave BLANK in local dev: the browser then uses same-origin relative /api/*
# URLs that the Next dev server proxies to the API (next.config.mjs rewrites),
# so auth cookies are first-party. Set to an absolute origin only if NOT using
# the proxy (cross-origin), which breaks cookie-based auth in dev.
NEXT_PUBLIC_API_BASE_URL=

# Client-side resume size pre-validation ceiling, in bytes. Mirrors the backend
# `MATCHLAYER_RESUME_MAX_BYTES` so the Upload_Page can reject an oversized file
# before issuing the upload request (Requirement 12.4). The backend remains the
# authoritative limit (413 `payload_too_large`); this is only an early-failure
# UX guard. Default 5242880 (5 MiB).
NEXT_PUBLIC_RESUME_MAX_BYTES=5242880
